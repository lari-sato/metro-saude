{
  "expo": {
    "name": "Metrô Saúde",
    "slug": "metro-saude",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "metrosaude",
    "icon": "./assets/app.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app.png"
      }
    },
    "splash": {
      "image": "./assets/app.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app.png",
          "resizeMode": "contain"
        }
    ],
    [
      "expo-font",
      {
        "fonts": ["node_modules/@expo-google-fonts/poppins/900Black/Poppins_900Black.ttf"]
      }
    ]
  ]
}}


